<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup> 
      <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.1" />
  </startup>
  <appSettings>
    <!--Please refer to developer's portal (https://developer.saxobank.com/sim/openapi/portal/) for access token.-->
    <add key="AccessToken" value="#access_token#" />
    
    <add key="OpenApiBaseUrl" value="https://gateway.saxobank.com/sim/openapi" />
    
    <add key="StreamingBaseUrl" value="https://streaming.saxotrader.com/sim/openapi" />
  </appSettings>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-13.0.0.0" newVersion="13.0.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>